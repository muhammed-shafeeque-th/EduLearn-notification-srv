
# EDULEARN NOTIFICATION SERVICE ENVIRONMENT CONFIGURATION
# Copy this file to .env and update the values according to your environment

# SERVICE CONFIGURATION
SERVICE_NAME=notification-service
SERVICE_VERSION=1.0.0
ENVIRONMENT=development

# DATABASE CONFIGURATION
DATABASE_DSN=postgresql://postgres:password@localhost:5432/notification_service?sslmode=disable
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=notification_service
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_SSL_MODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=5m
DB_CONN_MAX_IDLE_TIME=5m

# REDIS CONFIGURATION
REDIS_ADDR=localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_MAX_ACTIVE=10
REDIS_MAX_IDLE=5
REDIS_IDLE_TIMEOUT=300s
REDIS_CLUSTER_ENABLED=false
REDIS_CLUSTER_NODE_1=
REDIS_CLUSTER_NODE_2=
REDIS_CLUSTER_NODE_3=

# KAFKA CONFIGURATION
KAFKA_BROKERS=localhost:9092
KAFKA_CONSUMER_GROUP=notification-service-group
KAFKA_BROKER_1=localhost:9092
KAFKA_BROKER_2=localhost:9093
KAFKA_BROKER_3=localhost:9094
KAFKA_SASL_ENABLED=false
KAFKA_SASL_MECHANISM=PLAIN
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
KAFKA_TLS_ENABLED=false
KAFKA_TLS_CA_CERT=
KAFKA_TLS_CLIENT_CERT=
KAFKA_TLS_CLIENT_KEY=

# SMTP CONFIGURATION
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_TLS_ENABLED=true
SMTP_TLS_SKIP_VERIFY=false
SMTP_RATE_LIMIT_RPM=60
SMTP_RATE_LIMIT_BURST=10


# PRODUCTION SETTINGS (uncomment and configure for production)

# ENVIRONMENT=production
# LOG_LEVEL=warn
# LOG_FORMAT=json

